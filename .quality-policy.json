{
  "code": {
    "excludedFolders": [
      "playwright-report",
      "test-results"
    ],
    "roleRules": [
      {
        "role": "test",
        "match": "any",
        "namePattern": "(\\.(test|spec)\\.[jt]sx?$)",
        "pathPattern": "(^|/)(tests?|specs?)(/|$)",
        "ignoreCase": true
      },
      {
        "role": "component",
        "match": "any",
        "extensions": [".tsx", ".jsx", ".vue"],
        "pathPattern": "(^|/)components(/|$)"
      },
      {
        "role": "hook",
        "match": "any",
        "namePattern": "^use[A-Z]",
        "pathPattern": "(^|/)hooks(/|$)"
      },
      {
        "role": "service",
        "match": "any",
        "namePattern": "(^|[.\\-_])(service|api|client)([.\\-_]|$)",
        "pathPattern": "(^|/)services(/|$)",
        "ignoreCase": true
      },
      {
        "role": "utils",
        "match": "any",
        "namePattern": "(^|[.\\-_])(utils?|helpers?)([.\\-_]|$)",
        "pathPattern": "(^|/)(utils?|helpers?)(/|$)",
        "ignoreCase": true
      },
      {
        "role": "module",
        "default": true
      }
    ],
    "limits": {
      "test": 1200,
      "component": 150,
      "hook": 150,
      "service": 200,
      "utils": 150,
      "module": 250
    }
  }
}
